# =================================
# Forgejo + PostgreSQL 環境設定
# =================================

# ------------------------------
# PostgreSQL データベース設定
# ------------------------------
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=forgejo_password
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --locale=C

# ------------------------------
# Forgejo ユーザー設定
# ------------------------------
USER_UID=1000
USER_GID=1000

# ------------------------------
# Forgejo サーバー設定
# ------------------------------
# ドメイン名（本番環境では変更必須）
# localhost または IPアドレスを指定可能
FORGEJO_DOMAIN=localhost

# HTTP ポート
FORGEJO_HTTP_PORT=3000

# ベースURL（本番環境では変更必須）
# localhost または IPアドレスを指定可能
FORGEJO_ROOT_URL=http://localhost:3000/

# SSH設定
FORGEJO_DISABLE_SSH=false
FORGEJO_SSH_PORT=222

# ------------------------------
# 本番環境用設定例（コメントアウト）
# ------------------------------
# FORGEJO_DOMAIN=git.yourcompany.com
# FORGEJO_ROOT_URL=https://git.yourcompany.com/
# POSTGRES_PASSWORD=your_super_secure_password_here

# IPアドレス使用例（ローカルネットワーク環境）
# FORGEJO_DOMAIN=192.168.0.131
# FORGEJO_ROOT_URL=http://192.168.0.131:3000/
# FORGEJO_INSTANCE_URL=http://192.168.0.131:3000

# ------------------------------
# サブパス用設定例（コメントアウト）
# ------------------------------
# FORGEJO_DOMAIN=example.com
# FORGEJO_ROOT_URL=https://example.com/forgejo/

# ------------------------------
# Forgejo Actions ランナー設定
# ------------------------------
# ランナーのインスタンスURL（IPアドレス固定）
FORGEJO_INSTANCE_URL=http://localhost:3000

# ランナー登録トークン（管理画面から取得したトークンに置換してください）
FORGEJO_RUNNER_REGISTRATION_TOKEN=your-runner-registration-token-here

# ランナー名
FORGEJO_RUNNER_NAME=your-runner-name

# ランナーラベル
FORGEJO_RUNNER_LABELS=ubuntu-latest:docker://ghcr.io/catthehacker/ubuntu:act-22.04,ubuntu-22.04:docker://ghcr.io/catthehacker/ubuntu:act-22.04,selfhosted:host,docker:docker://ghcr.io/catthehacker/ubuntu:act-22.04

# ------------------------------
# Forgejo Pages 設定
# ------------------------------
PAGES_SERVER=http://server:3000
PAGES_TOKEN=your-api-token-here
PAGES_BIND=:8080
PAGES_BRANCH=static-pages

# ------------------------------
# Gradio Pages 設定
# ------------------------------
FORGEJO_URL=http://localhost:3000
GRADIO_PAGES_TOKEN=your-gradio-api-token-here

# ------------------------------
# Webhook Pages 設定
# ------------------------------
# 注意: REPO_URLとBRANCH_NAMEはWebhookペイロードから動的に取得されます
# 以下の設定はデフォルト値としてのみ使用されます

# デフォルトのデプロイ対象ブランチ名
BRANCH_NAME=static-pages

# Forgejoで生成したアクセストークン
# アクセストークンは全リポジトリの読み取り権限(read:repository)が必要です
FORGEJO_ACCESS_TOKEN=your-forgejo-access-token-here

# Webhookのシークレットキー（任意の文字列）
WEBHOOK_SECRET=your-webhook-secret-key-here
